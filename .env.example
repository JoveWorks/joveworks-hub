# Generate real secrets, for example:
#   openssl rand -hex 32
JOVEWORKS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Required before a restricted catalogue can be downloaded. Keep it separate
# from the admin token and distribute it only through the cloud's normal channel.
JOVEWORKS_CLOUD_TOKEN=replace-with-a-cloud-token
# Required for cloud-material links (/p/<id>). These are the browser-visible
# HTTPS roots, not Docker-internal addresses.
JOVEWORKS_PUBLIC_URL=https://jovehub.thomasvanriel.com
JOVEWORKS_EDITOR_URL=https://editor.example.edu
# Production Compose binds Hub to this host address. Leave it on loopback when
# Nginx runs on the same host; do not expose port 8080 directly to the Internet.
JOVEWORKS_HOST_BIND=127.0.0.1
# Port 8080 is already occupied on this server. Nginx proxies to this
# loopback-only port; it must not be forwarded by the router.
JOVEWORKS_HOST_PORT=8083
RUST_LOG=info
