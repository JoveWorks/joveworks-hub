# Generate real secrets, for example:
#   openssl rand -hex 32
JOVEWORKS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Required before a restricted catalogue can be downloaded. Keep it separate
# from the admin token and distribute it only through the course's normal channel.
JOVEWORKS_COURSE_TOKEN=replace-with-a-course-token
# Required for short workspace links (/w/<id>). These are the browser-visible
# HTTPS roots, not Docker/WSL internal addresses.
JOVEWORKS_PUBLIC_URL=https://hub.example.edu
JOVEWORKS_EDITOR_URL=https://editor.example.edu
RUST_LOG=info
